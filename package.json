{
  "name": "@wombatfish/opencode-toolcall-repair",
  "version": "0.1.1",
  "description": "OpenCode plugin: repairs open-model tool-call wire-format violations (DeepSeek/Qwen/GLM/Kimi/etc.) via an in-process OpenAI-compatible repair proxy, before opencode's AI SDK validates them.",
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts"
  },
  "main": "./src/plugin.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "bun run src/proxy.ts",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tool-call",
    "ollama",
    "deepseek",
    "ai-sdk",
    "harness"
  ],
  "license": "MIT",
  "author": "wombatfish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wombatfish/opencode-toolcall-repair.git"
  },
  "homepage": "https://github.com/wombatfish/opencode-toolcall-repair#readme",
  "bugs": {
    "url": "https://github.com/wombatfish/opencode-toolcall-repair/issues"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.48",
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
